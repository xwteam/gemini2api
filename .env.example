GEMINI_PSID=your__Secure-1PSID_cookie_value
GEMINI_PSIDTS=your__Secure-1PSIDTS_cookie_value
API_KEY=
# 可选：管理面板/admin 独立鉴权 key（留空则回退用 API_KEY，单 key 管全部，零回归）
ADMIN_API_KEY=
# 可选：CORS 跨域白名单（默认 * 与原行为一致；可改逗号分隔白名单收紧）
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
REFRESH_INTERVAL=30
MAX_RETRIES=3
PORT=5918
LOG_LEVEL=info
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=10
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=5
ACCOUNTS_FILE=accounts.json
ROTATION_STRATEGY=round-robin
MAX_CONCURRENT_PER_ACCOUNT=8
# 并发满载时排队等待可用槽位的上限（秒），等不到才报错
ACQUIRE_TIMEOUT=60.0
# 遇 5xx 时同账号快速重试次数，仍失败则换号 failover；被限流账号的冷却时长（秒）
SAME_ACCOUNT_5XX_RETRIES=1
FAILOVER_COOLDOWN=30.0
# 指纹/版本同步/抖动
FINGERPRINT_CONFIG_PATH=data/fingerprint.json
VERSION_SYNC_ENABLED=true
VERSION_SYNC_INTERVAL=24
JITTER_ENABLED=true
# 用量统计
USAGE_STATS_ENABLED=true
USAGE_STATS_INTERVAL=300
USAGE_STATS_RETENTION_DAYS=30
# 模型白名单（逗号分隔，留空则不过滤）
MODEL_WHITELIST=
# Gemini 网页端会话自动清理
CHAT_CLEANUP_ENABLED=true
CHAT_CLEANUP_KEEP_HOURS=24.0
CHAT_CLEANUP_INTERVAL_HOURS=6.0
CHAT_CLEANUP_SKIP_PINNED=true
# 默认思考档位：客户端没指定档位时用哪一档，off / low / medium / high，出厂 low。
# "没指定档位"包括没传思考参数的，和要了思考但没说几档的（Claude Code 出厂请求就是这种：
# adaptive + effort high）。实测 low 比不思考平均每请求多约 5 秒（flash 简单题）；客户端
# 没提思考时流式正文要等思考做完才开始出（期间只有保活帧），pro 遇到需要推理的题 low 档
# 实测总耗时 36～47 秒。最看重速度就设 off。客户端明确指定了档位（reasoning_effort: high、
# budget_tokens、thinkingLevel、Claude Code 的 /effort max 等）时按客户端的走。
# 客户端完全没提思考时，按默认档替它开的思考只用于上游生成，不会回传。面板「设置」里可即时切换。
DEFAULT_THINKING_LEVEL=low
# 「允许思考」总闸：false = 一律不思考，连客户端明确指定档位的思考也忽略（真正最快）。
# 默认档 off 管不到明确指定了档位的请求；要让它们也不思考就把这里设成 false
# （面板「设置 → 思考」里同样可即时切换）。
EXTENDED_THINKING_ENABLED=true
# 生图代下载尺寸后缀（=s0 为全分辨率原图）与单次下载超时（秒）
IMAGE_DOWNLOAD_SIZE_SUFFIX==s2048
IMAGE_DOWNLOAD_TIMEOUT=25.0
# Gemini→第三方 兜底链：任意 Gemini 模型报错/返回空响应时，自动改用 API Key 池中的第三方模型原生重试（客户端无感）。
# 默认自动取池中所有“适合聊天”的第三方（排除 image/video/audio/embedding 等），随机轮询、失败自动换下一个。
# FALLBACK_MODELS 可选：留空=自动；或填逗号分隔的模型名精确指定（按序尝试，须已在 API Key 池配置）。
FALLBACK_ENABLED=false
FALLBACK_MODELS=
# 第三方直连「同名多家」故障切换：某第三方报错/额度耗尽时自动切下一家同名第三方；坏家冷却时长（秒）。
# 设 0 关闭冷却。默认生效、无开关——仅当某模型配置了同名多家时才有行为变化，单家零回归。
THIRDPARTY_FAILOVER_COOLDOWN=180.0
# 完整请求/响应体记录（面板日志详情视图）。默认关：请求体含用户完整提示词，属隐私 + 体积敏感。
# 开启后只记 body、不记任何请求头；流式响应只记一个标记，绝不缓冲整个流；超大响应体截断标注（单条上限 4KB）。
# 内存开销提示：body 只留在内存环形缓冲区（不落盘），按 2000 条 * 4KB 计算，最多约 8MB 常驻内存。
# 也可在面板「设置 → 日志诊断」里直接开关，改完立即生效、无需重启（中间件按请求读取该值）。
LOG_BODIES_ENABLED=false
# Gemini 在 HTTP 200 正文里返回的拒绝块（BardErrorInfo）的 code→语义对照表，
# 形如 BARD_ERROR_CODES=1152=rate_limit,404=session_expired
# 可用分类：rate_limit（限流，冷却该账号并换号重试）/ session_expired（会话过期，触发 cookie 自愈）/
#           context_too_long（上下文超长，直接报 400 不重试）/ captcha（人机验证，让出该账号）。
# 默认空：这些 code 的语义 Google 没有公开文档，认不出的 code 一律按 rate_limit 的口径处理
# （503：冷却该账号 + 换号重试）。抓到真机样本后往这里配即可生效。
BARD_ERROR_CODES=
# 谷歌用来代替回答的「失败套话」，用 | 分隔追加（内置的那句始终生效，空条目忽略），例如
#   GEMINI_FAILURE_REPLIES=我好像遇到了错误，可以换个问题试试吗？|Something went wrong. Try again later.
# 谷歌侧故障时 Gemini 会秒回 HTTP 200、正文恰好是一句
# "I seem to be encountering an error. Can I try something else for you?"。整段正文（去首尾空白、
# 连续空白压成一个、不分大小写）恰好等于其中一条才按上游失败处理（换号 / 兜底 / 502），包含、前缀
# 都不算；带图的回答、用户本来就让模型复述这句时不判。在别的语言 / 措辞上抓到样本时往这里加。
GEMINI_FAILURE_REPLIES=
# 对话的生成超时，按模型族分层（秒），形如 GENERATE_TIMEOUTS=flash-lite=60,flash=120,pro=300
# 留空 = 用内置分层（flash-lite 60 / flash 120 / pro 300 / argon 300；认不出的族 60）。
# 旧配置里的 flash-thinking=... 已无对应模型族（gemini-flash-thinking 已下线为 gemini-flash 的隐藏别名），被忽略、无害。
# 非流式：整个 POST 按这个预算掐断。流式（v1.6.46 起）同样受它约束：第一次「进展」（正文 / 思考 /
# 生成图片 / Canvas 有新内容）必须在预算内到达（等响应头也算），之后相邻两次进展的间隔也不能超过它；
# 谷歌排队时每 60 秒发一个不含内容的心跳帧，它不算进展。
# ⚠️ 非流式路径在 generate() 返回之前是零字节输出（不是空闲读超时，是**首字节**超时），
#    所以这个值必须小于前置代理/CDN 的首字节超时，否则客户端拿到的是代理的 504 而不是我们的
#    错误体（例如 EdgeOne 免费版是 15s、很多反代默认 60s）。
GENERATE_TIMEOUTS=
# 「疑似生图」时把上面的预算抬到至少这个值（取大，不覆盖：pro 生图不该比 pro 纯文本更短）。
# 流式与非流式同口径（v1.6.46 起流式不再有自己写死的 120s / 180s 包线）。
GENERATE_TIMEOUT_IMAGE=180.0
# 模型级熔断：谷歌某个模型族整体故障时（例如 gemini-flash 全部账号都在排队卡住 / 秒回失败套话），
# 开了第三方兜底（FALLBACK_ENABLED）的 /v1/chat/completions 请求暂时直接走兜底，不再每次先白等一个预算。
# - 只有「疑似故障」才计数：谷歌的失败套话、几乎没收到数据（< 1KB）的非流式生成超时、一次进展都没有的
#   流式超时；建连期超时、谷歌的拒绝块、4xx、池满、客户端断连、空响应都不算。
# - WINDOW 秒内有 THRESHOLD 个**不同请求**这样失败（同一请求换号 / 重试 / 客户端重发只算一个）→ 打开
#   COOLDOWN 秒；到期后放一个真实请求去试探谷歌：试探失败开放期翻倍（封顶 MAX_COOLDOWN），任何成功都恢复。
# - 没开兜底的请求、Claude / Gemini 原生 / Responses / 研究 / 生图一律照常调谷歌（结果照样更新熔断状态）。
# - 状态在面板账号页顶部和 /admin/status 的 model_breakers 里看；进程重启后清空。
# - 非法值（写错、≤0、阈值 <1）回退默认值并打 WARNING；MAX_COOLDOWN 至少等于 COOLDOWN。
#   MODEL_BREAKER_ENABLED=false 时照常记录（日志 / 状态可看），但绝不绕开谷歌。
MODEL_BREAKER_ENABLED=true
MODEL_BREAKER_THRESHOLD=2
MODEL_BREAKER_WINDOW=300
MODEL_BREAKER_COOLDOWN=60
MODEL_BREAKER_MAX_COOLDOWN=300

# 说明：面板里改过的设置项会存进 data/settings-overrides.json，并在每次启动时回放，
# 优先级**高于**本文件和环境变量（Docker 部署下 env_file 注入的是真实环境变量，
# 只写 .env 压不住它，面板改动会在重启后被打回原形）。
# 因此如果你改了本文件某项却发现没生效，看启动日志里的
# "Applied N panel setting override(s)"，删掉 data/settings-overrides.json 即可交回本文件接管。

# 访问密钥用量的**美元估算**价格表，形如
#   TOKEN_PRICES=gemini-pro=2.0/12.0,gemini-flash=0.75/3.75,gemini-argon=2.0/10.0
# 公开模型名=输入价/输出价，单位 USD / 百万 token。留空 = 用内置默认值
# （按 Google 官方 Gemini API 公布的标准付费档，2026-10-21 北京时间抓取）。
# ⚠️ 这个数字只是「同样的内容若走官方 API 大约要多少钱」的参考值：本服务走网页版、
#    本身不花钱；token 数是 len(text)//4 估出来的、不是真分词器（中文会明显低估）。
# **不参与任何限额判定** —— 额度限制只有 REQUEST_LIMIT（计次）那一条。
# 配不到价格的模型在面板上显示 "—"，不会回落到某个「差不多」的价。
TOKEN_PRICES=
